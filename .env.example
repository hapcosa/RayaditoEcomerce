# Piedras Rayadito — variables de entorno.
# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# --- Núcleo ---
DEBUG=true
SECRET_KEY=change-me-dev-only-generate-a-real-one-in-prod

# --- Base de datos (los valores por defecto calzan con docker-compose.yml) ---
DB_NAME=piedrasrayadito
DB_USER=rayadito
DB_PASSWORD=rayadito
DB_HOST=127.0.0.1
DB_PORT=15432

# --- Hosts / CORS / CSRF (listas separadas por coma) ---
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- OAuth Google / Facebook (opcional en desarrollo) ---
# El front Next.js (login social) usa el flujo djoser /auth/o/{provider}/.
GOOGLE_CLIENT_KEY=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_KEY=
FACEBOOK_CLIENT_SECRET=
# Callbacks permitidos para el intercambio de code (coma-separados). El default
# ya incluye http://localhost:3000/auth/social/callback para desarrollo; en prod
# agrega https://piedrasdelrayadito.cl/auth/social/callback.
# SOCIAL_AUTH_ALLOWED_REDIRECT_URIS=https://piedrasdelrayadito.cl/auth/social/callback

# --- Email (en desarrollo usa la consola; en producción define SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Piedras Rayadito <no-reply@piedrasdelrayadito.cl>
# Avisos al dueño: a quién le llega la venta aprobada. Vacío = sin avisos.
# Varios separados por coma.
# ADMIN_NOTIFY_EMAILS=contacto@piedrasdelrayadito.cl
# Dominio público del backend, para que el aviso traiga link al pedido.
# BACKEND_BASE_URL=https://api.piedrasdelrayadito.cl
# Push a la app admin: solo si la cuenta Expo tiene "enhanced security".
# EXPO_ACCESS_TOKEN=
# Plazo para despachar un pedido pagado y cuánto antes avisar (en horas).
# DISPATCH_SLA_HOURS=72
# DISPATCH_WARN_HOURS=24

# --- Boletas y facturas (SII). Ver docs/SII.md ---
# off (sin inicio de actividades) | voucher (comprobante MercadoPago = boleta)
# | provider (emite un proveedor externo).
# BILLING_MODE=off
# BILLING_PROVIDER=
# Mostrar "Necesito factura" en el checkout (sin efecto con BILLING_MODE=off).
# BILLING_INVOICES_ENABLED=false

# --- Instagram (Fase 6, API oficial de Meta). Ver docs/INSTAGRAM.md ---
# Sin estos dos la app no deja programar publicaciones.
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=       # solo transicion: el token va en la base (manage.py instagram_token set)
# graph.instagram.com (Instagram Login) o graph.facebook.com (Facebook Login).
# INSTAGRAM_GRAPH_HOST=graph.instagram.com
# INSTAGRAM_GRAPH_VERSION=v23.0
# Hashtags del texto sugerido, separados por coma.
# INSTAGRAM_HASHTAGS=#PiedrasRayadito,#Chiloe,#JoyeriaArtesanal
# El enlace al producto sale de FRONTEND_BASE_URL (sección MercadoPago).

# --- WhatsApp Cloud API (avisos al cliente, API oficial de Meta). Ver docs/WHATSAPP.md ---
# Apagado salvo que estén el flag, el id del número y el token.
# WHATSAPP_ENABLED=false
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_GRAPH_VERSION=v23.0
# WHATSAPP_TEMPLATE_LANGUAGE=es_CL

# --- MercadoPago (Fase 2) ---
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_NOTIFICATION_URL=https://tu-dominio.cl/api/payment/webhook
# URL del front Next.js: MercadoPago arma con ella las back_urls (success/failure).
FRONTEND_BASE_URL=http://localhost:3000

# --- Producción: forzar HTTPS/HSTS (dejar comentado en dev) ---
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000

# --- pgAdmin (docker-compose) ---
PGADMIN_EMAIL=admin@rayadito.local
PGADMIN_PASSWORD=admin

# --- Fase 7: infraestructura ---------------------------------------------
# Detrás del túnel de Cloudflare, para que Django arme URLs con el dominio
# público y no con localhost (de ahí sale la notification_url de MercadoPago).
# USE_X_FORWARDED_HOST=true

# Cloudflare ya fuerza HTTPS; el redirect acá solo agrega un salto extra.
# SECURE_SSL_REDIRECT=false

# Almacenamiento de las fotos de producto: 'local' (disco del servidor) o 's3'
# (S3 / Cloudflare R2 vía django-storages).
# MEDIA_STORAGE=s3
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=          # solo para R2 y compatibles
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=         # dominio publico del bucket, sin https:// ni slash final
#                               # (obligatorio en R2; ver docs/DEPLOY.md)

# Rate limiting (DRF). Solo por scope: ver docs/DEPLOY.md.
# THROTTLE_PAYMENT=10/min
# THROTTLE_SUGGESTIONS=5/min
# THROTTLE_REVIEWS=20/min
# Cantidad de proxies que agregan a X-Forwarded-For. VERIFICAR contra el sitio
# desplegado: un valor mal puesto hace que todos compartan cuota o que se pueda
# falsear la IP.
# NUM_PROXIES=

# Backend de caché. Con locmemcache cada worker de gunicorn cuenta aparte.
# CACHE_URL=redis://127.0.0.1:6379/0

# Sentry. Opt-in: sin DSN no se inicializa.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Starken (envíos cotizados por comuna; ver docs/STARKEN.md) ---
# Apagado: el checkout ofrece solo las opciones de precio fijo.
# STARKEN_ENABLED=false
# STARKEN_API_URL=https://restservices-qa.starken.cl/apiqa/starkenservices/rest
# STARKEN_RUT=
# STARKEN_CLAVE=
# STARKEN_ORIGIN_CITY=388        # codigo de ciudad de origen (Castro)
# STARKEN_CTA_CTE=
# STARKEN_CTA_CTE_DV=
# STARKEN_CENTRO_COSTO=0
# STARKEN_PARCEL_KG=1
# STARKEN_PARCEL_CM=20,15,10     # alto, ancho, largo
# STARKEN_EMISSION_URL=https://emisionh2h-qa.starken.cl/starkenh2h/servlet/aemisionh2hremrest
# STARKEN_EMITTER_COMPANY_RUT=
# STARKEN_EMITTER_USER_RUT=
# STARKEN_EMITTER_PASSWORD=
# STARKEN_SENDER_RUT=            # con guion y DV
# STARKEN_SENDER_NAME=
# STARKEN_SENDER_STREET=
# STARKEN_SENDER_NUMBER=
# STARKEN_SENDER_COMMUNE=
# STARKEN_SENDER_PHONE=
# STARKEN_SENDER_EMAIL=
