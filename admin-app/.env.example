# URL base de la API DRF de Piedras Rayadito.
# En dev, el teléfono NO puede usar localhost: usá la IP LAN de la máquina que
# corre Django (mirala con `ip addr` / `hostname -I`), por ejemplo:
EXPO_PUBLIC_API_URL=http://192.168.1.50:8000

# Copiá este archivo a `.env` y ajustá la IP. Las vars EXPO_PUBLIC_* se
# embeben en el bundle en build/start.
