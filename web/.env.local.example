# URL base del backend Django (sin /api ni slash final).
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Base de la API DRF de Django (sin slash final).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# URL pública del sitio (para metadata / OG / sitemap). En prod: https://tudominio.cl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ⚠️  Django: en tu .env del backend agrega:
# FRONTEND_BASE_URL=http://localhost:3000
# (MercadoPago usa esto para las back_urls; el valor por defecto apunta al Vite SPA en :5173)
